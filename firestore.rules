rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Store owner account. Only this account can access the current shared data document.
    // Employee-specific access requires a separate employee membership model and rules.
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'loi0933451652@gmail.com';
    }
    match /shops/{shopId}/data/{docId} {
      allow read, write: if isOwner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
